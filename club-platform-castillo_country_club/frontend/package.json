{
  "name": "castillo-country-club-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify:integration": "tsx ../scripts/verify-integration.ts",
    "guardian": "tsx tools/architecture-guardian.ts",
    "guardian:fix": "tsx tools/architecture-guardian.ts --fix",
    "precommit": "pnpm run guardian && pnpm run lint && pnpm run type-check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/query-core": "^5.104.5",
    "@types/glob": "^8.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^8.1.0",
    "globals": "^15.0.0",
    "happy-dom": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
