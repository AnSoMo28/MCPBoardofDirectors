{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],

    /* Bundler mode (tsx consume directamente el TS de tools/). */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* El código que POLICÍA la app (architecture-guardian, validadores) no
       puede ser el menos vigilado de la casa: mismo strict que src/. */
    "strict": true
  },
  "include": ["vite.config.ts", "tools/**/*.ts"]
}
